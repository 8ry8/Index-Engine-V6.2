# ── Node / tooling ─────────────────────────────────────────────────────
node_modules/
npm-debug.log*
package-lock.json

# ── Build output ───────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Native mobile projects (generated by capacitor) ────────────────────
# Committed projects should remove these lines; they are ignored while the
# generators are still being iterated on.
android/app/build/
ios/App/build/
*.xcuserstate
xcuserdata/
DerivedData/

# ── Secrets — NEVER commit ─────────────────────────────────────────────
*.keystore
*.jks
keystore.properties
android/keystore.properties
ExportOptions.plist
*.p8
*.p12
*.mobileprovision
.env
.env.*
!.env.example

# ── Generated ledger artifacts ─────────────────────────────────────────
V6_Archive_*.csv
ledger.csv
SHA256SUMS.txt

# ── Rename backups: must never be archived or synced ───────────────────
.ledger-backup/
rename-dryrun.txt

# ── OS / editor ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
